# Airflow core
AIRFLOW__CORE__EXECUTOR=SequentialExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-to-a-random-string

# findmycalling
FMC_APP_URL=https://findmycalling.vercel.app
FMC_CRON_SECRET=your-cron-secret-from-vercel

# zombie-trade-bot (set after Azure deployment)
ZTB_APP_URL=https://zombie-trade-bot.your-app.azurecontainerapps.io
ZTB_API_SECRET=your-ztb-api-secret
